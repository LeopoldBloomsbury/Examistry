{
  "expo": {
    "name": "CPA StudyPilot",
    "slug": "cpa-studypilot-mobile",
    "scheme": "cpastudypilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cpastudypilot.mobile"
    },
    "android": {
      "package": "com.cpastudypilot.mobile"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-status-bar"
    ]
  }
}
